# ============================================
# Gym Management App - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# ── Neon Postgres — Gym-Admin (Central Database) ──────
# Connection string for the main admin database.
# Found in Neon Console → Dashboard → Connection string.
DATABASE_URL=postgresql://neondb_owner:xxxx@ep-xxxx.us-east-1.aws.neon.tech/gym_admin?sslmode=require

# ── Neon Organization API Key ─────────────────────────
# Org-wide key to create/manage Neon projects for each gym.
# Found in Neon Console → Account Settings → API Keys.
NEON_API_KEY=napi_org_xxxx

# ── Neon Auth ─────────────────────────────────────────
# Base URL of the Neon Auth service.
# Enable Auth in Neon Console → Project → Branch → Auth.
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.us-east-1.aws.neon.tech

# API key for server-side user management.
NEON_AUTH_API_KEY=napi_xxxx

# Cookie secret for signing session data (minimum 32 characters).
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=your-cookie-secret-at-least-32-characters-long

# ── Vendor Config Encryption ──────────────────────────
# AES-256 key for encrypting vendor Neon credentials in the database.
# Generate with: openssl rand -hex 32
VENDOR_CONFIG_ENCRYPTION_KEY=your-256-bit-hex-key-here

# ── Client-side (Vite) ────────────────────────────────
VITE_NEON_AUTH_URL=/api/auth

# ── Server ────────────────────────────────────────────
PORT=5000
