# ============================================
# Gym Management App - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# ── Neon Postgres — Gym-Admin (Central Database) ──────
# Connection string for the main admin database.
DATABASE_URL=postgresql://neondb_owner:xxxx@ep-xxxx.us-east-1.aws.neon.tech/gym_admin?sslmode=require

# ── Neon Organization API Key ─────────────────────────
NEON_API_KEY=napi_org_xxxx

# ── Firebase Admin SDK (server-side) ──────────────────────────────────
# From Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# ── Firebase Web App (client-side) ────────────────────────────────────
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=1:your-sender-id:web:xxxx
VITE_FIREBASE_MEASUREMENT_ID=G-XXXX

# ── Admin Config ──────────────────────────────────────
# Platform Admin Firebase User UID
ADMIN_UID=your-firebase-admin-uid
VITE_ADMIN_UID=your-firebase-admin-uid

# ── Vendor Config Encryption ──────────────────────────
VENDOR_CONFIG_ENCRYPTION_KEY=your-256-bit-hex-key-here

# ── Server ────────────────────────────────────────────
PORT=5000
