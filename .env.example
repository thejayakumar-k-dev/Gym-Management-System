# ============================================
# Gym Management App - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# Supabase Configuration (required - used for auth + database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Client-side Supabase (same values, prefixed with VITE_ for frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Database URL (required for drizzle-kit migrations)
DATABASE_URL=postgresql://user:password@localhost:5432/gym_db

# Server Port (optional, defaults to 5000)
PORT=5000
