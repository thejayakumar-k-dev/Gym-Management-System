# ============================================
# Gym Management App - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# ── Neon Postgres — Gym-Admin (Central Database) ──────
DATABASE_URL=postgresql://neondb_owner:xxxx@ep-xxxx.us-east-1.aws.neon.tech/gym_admin?sslmode=require
NEON_DATABASE_URL=postgresql://neondb_owner:xxxx@ep-xxxx.us-east-1.aws.neon.tech/gym_admin?sslmode=require

# ── Neon Organization API Key ─────────────────────────
NEON_API_KEY=napi_org_xxxx

# ── Firebase Web App ──────────────────────────────────
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=1:your-sender-id:web:xxxx
VITE_FIREBASE_MEASUREMENT_ID=G-XXXX

# ── Admin Config ──────────────────────────────────────
VITE_ADMIN_UID=your-firebase-admin-uid

# ── Firebase Admin Service Account (Base64 for clean Vercel import) ──
# Base64 encoded string of serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_BASE64=your-base64-encoded-service-account-json
# Or local file path:
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json

# ── Vendor Config Encryption ──────────────────────────
VENDOR_CONFIG_ENCRYPTION_KEY=your-256-bit-hex-key-here

# ── Server ────────────────────────────────────────────
PORT=5000
